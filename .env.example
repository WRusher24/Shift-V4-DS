# ---------------------------------------------------------------------------
# Shift (שיפט) — environment configuration
# Copy this file to `.env.local` for local development.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# 1. Database
# ---------------------------------------------------------------------------
# Neon PostgreSQL pooled connection string. Copy it from the Neon console
# (Dashboard -> your project -> Connection Details -> "Pooled connection").
#
#   postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<db>?sslmode=require
#
# If DATABASE_URL is left EMPTY the application automatically boots into
# "Local File Mode": a fully functional, zero-configuration data layer backed
# by `.data/shift-db.json`. That mode is intended for local development,
# evaluation and demos ONLY — it is not durable on serverless platforms.
DATABASE_URL=

# Unpooled / direct connection string, used exclusively by migrations & seeding
# (`npm run db:migrate`, `npm run db:seed`). Optional: when omitted,
# DATABASE_URL is used instead.
DATABASE_URL_UNPOOLED=

# ---------------------------------------------------------------------------
# 2. Data layer behaviour
# ---------------------------------------------------------------------------
# Force the local JSON file store even when DATABASE_URL is present.
# Values: "true" | "false"  (default: false)
SHIFT_FORCE_LOCAL_STORE=false

# Absolute or relative path of the local JSON store.
# (default: .data/shift-db.json)
SHIFT_LOCAL_STORE_PATH=.data/shift-db.json

# ---------------------------------------------------------------------------
# 3. Operational defaults (all overridable later from the Admin UI)
# ---------------------------------------------------------------------------
# Minimum active hours a worker must accumulate inside a race to qualify for a
# prize on the Efficiency leaderboard.
SHIFT_MIN_RACE_HOURS=30

# Idle timeout (seconds) before the dashboard switches to full-screen TV Mode.
SHIFT_TV_IDLE_SECONDS=10

# ---------------------------------------------------------------------------
# 4. Vercel / deployment
# ---------------------------------------------------------------------------
# Vercel injects these automatically; listed here for documentation purposes.
# VERCEL_URL=
# VERCEL_ENV=
